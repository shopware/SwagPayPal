{
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowJs": false,

    /* Interop Constraints */
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "noEmit": true,
    "strict": true,
    "checkJs": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,

    "types": ["node"],

    "paths": {
      "@fixtures/*": ["./fixtures/*"],
      "@page-objects/*": ["./page-objects/*"],
      "@tasks/*": ["./tasks/*"],
      "@types/*": ["./types/*"],
      "@data/*": ["./test-data/*"],
      "@services/*": ["./services/*"],
      "SwagPayPal/*": ["../../src/Resources/app/administration/src/*"],
    }
  }
}
