{
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "Preserve",
    "skipLibCheck": true,
    "allowJs": false,
    "baseUrl": ".",

    /* Interop Constraints */
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "noEmit": true,
    "strict": true,
    "checkJs": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,

    "types": ["node"],

    "paths": {
      "@fixtures/*": ["fixtures/*"],
      "@page-objects/*": ["page-objects/*"],
      "@tasks/*": ["tasks/*"],
      "@data/*": ["test-data/*"],
      "@services/*": ["services/*"],
      "SwagPayPal/*": ["../../src/Resources/app/administration/src/*"],
    }
  }
}
