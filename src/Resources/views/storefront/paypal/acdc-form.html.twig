{% block swag_paypal_acdc_form %}
<div id="swag-paypal-acdc-form" class="swag-paypal-acdc-form d-none mt-2">
    <div class="row mb-2">
        <div class="col-sm-12">
            <label class="d-none" for="swag-paypal-acdc-form-cardholder">{{ "paypal.acdc.cardholderName"|trans|sw_sanitize }}</label>
            <div id="swag-paypal-acdc-form-cardholder" class="swag-paypal-acdc-form-field" data-placeholder="{{ "paypal.acdc.cardholderName"|trans|striptags }}"></div>
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-sm-12 swag-paypal-acdc-form-field-lg">
            <label class="d-none" for="swag-paypal-acdc-form-cardnumber">{{ "paypal.acdc.cardNumber"|trans|sw_sanitize }}</label>
            <div id="swag-paypal-acdc-form-cardnumber" class="swag-paypal-acdc-form-field" data-placeholder="{{ "paypal.acdc.cardNumber"|trans|striptags }}"></div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6 pe-sm-1">
            <label class="d-none" for="swag-paypal-acdc-form-expiration">{{ "paypal.acdc.expiration"|trans|sw_sanitize }}</label>
            <div id="swag-paypal-acdc-form-expiration" class="swag-paypal-acdc-form-field" data-placeholder="{{ "paypal.acdc.expiration"|trans|striptags }}"></div>
        </div>
        <div class="col-sm-6 ps-sm-1">
            <label class="d-none" for="swag-paypal-acdc-form-cvv">{{ "paypal.acdc.cvv"|trans|sw_sanitize }}</label>
            <div id="swag-paypal-acdc-form-cvv" class="swag-paypal-acdc-form-field" data-placeholder="{{ "paypal.acdc.cvv"|trans|striptags }}"></div>
        </div>
    </div>
</div>
{% endblock %}
