{# @var \Swag\PayPal\Checkout\ExpressCheckout\ExpressCheckoutData expressData #}
{% set expressData = page.cart.extensions[constant('Swag\\PayPal\\Checkout\\ExpressCheckout\\SalesChannel\\ExpressPrepareCheckoutRoute::PAYPAL_EXPRESS_CHECKOUT_CART_EXTENSION_ID')] %}
{# @var \Swag\PayPal\Checkout\SPBCheckout\SPBCheckoutButtonData spbData #}
{% set spbData = page.extensions[constant('Swag\\PayPal\\Util\\Lifecycle\\Method\\PayPalMethodData::PAYPAL_SMART_PAYMENT_BUTTONS_DATA_EXTENSION_ID')] %}
{# @var \Swag\PayPal\Storefront\Data\Struct\ACDCCheckoutFieldData acdcData #}
{% set acdcData = page.extensions[constant('Swag\\PayPal\\Util\\Lifecycle\\Method\\ACDCMethodData::PAYPAL_ACDC_FIELD_DATA_EXTENSION_ID')] %}
{# @var \Swag\PayPal\Checkout\PUI\PUIFraudNetData puiFraudnetData #}
{% set puiFraudnetData = page.extensions[constant('Swag\\PayPal\\Checkout\\PUI\\PUISubscriber::PAYPAL_PUI_FRAUDNET_PAGE_EXTENSION_ID')] %}
{# @var \Swag\PayPal\Storefront\Data\Struct\SEPACheckoutData sepaData #}
{% set sepaData = page.extensions[constant('Swag\\PayPal\\Util\\Lifecycle\\Method\\SEPAMethodData::PAYPAL_SEPA_FIELD_DATA_EXTENSION_ID')] %}
{# @var \Swag\PayPal\Storefront\Data\Struct\VenmoCheckoutData venmoData #}
{% set venmoData = page.extensions[constant('Swag\\PayPal\\Util\\Lifecycle\\Method\\VenmoMethodData::PAYPAL_VENMO_FIELD_DATA_EXTENSION_ID')] %}
{# @var \Swag\PayPal\Storefront\Data\Struct\PayLaterCheckoutData payLaterData #}
{% set payLaterData = page.extensions[constant('Swag\\PayPal\\Util\\Lifecycle\\Method\\PayLaterMethodData::PAYPAL_PAY_LATER_FIELD_DATA_EXTENSION_ID')] %}
{# @var \Swag\PayPal\Storefront\Data\Struct\ApplePayCheckoutData applePayData #}
{% set applePayData = page.extensions[constant('Swag\\PayPal\\Util\\Lifecycle\\Method\\ApplePayMethodData::PAYPAL_APPLE_PAY_FIELD_DATA_EXTENSION_ID')] %}
{# @var \Swag\PayPal\Storefront\Data\Struct\GooglePayCheckoutData googlePayData #}
{% set googlePayData = page.extensions[constant('Swag\\PayPal\\Util\\Lifecycle\\Method\\GooglePayMethodData::PAYPAL_GOOGLE_PAY_FIELD_DATA_EXTENSION_ID')] %}

{% block swag_paypal_checkout_buttons %}
<div class="swag-paypal-checkout-buttons {{ classes }}">
    {% if expressData %}

        {% block swag_paypal_express_checkout %}
        <input type="hidden" name="{{ constant('Swag\\PayPal\\Checkout\\Payment\\PayPalPaymentHandler::PAYPAL_EXPRESS_CHECKOUT_ID') }}" value="1">
        <input type="hidden" name="{{ constant('Swag\\PayPal\\Checkout\\Payment\\Method\\AbstractPaymentMethodHandler::PAYPAL_PAYMENT_ORDER_ID_INPUT_NAME') }}" value="{{ expressData.paypalOrderId }}">
        {% endblock %}

    {% elseif spbData and spbData.paymentMethodId is same as(context.paymentMethod.id) %}

        {% block swag_paypal_paypal %}
        <paypal-button
            class="swag-paypal-button shape-{{ spbData.buttonShape }} paypal-{{ spbData.buttonColor }}"
            data-swag-paypal-checkout-paypal="true"
            data-swag-paypal-checkout-paypal-options="{{ spbData|json_encode }}"
            hidden
        >
        </paypal-button>
        {% endblock %}

        {% if spbData.showPayLater %}
            {% block swag_paypal_paypal_pay_later %}
            <paypal-pay-later-button
                class="swag-paypal-button shape-{{ spbData.buttonShape }} paypal-gold"
                data-swag-paypal-checkout-pay-later="true"
                data-swag-paypal-checkout-pay-later-options="{{ spbData|json_encode }}"
                hidden
            >
            </paypal-pay-later-button>
            {% endblock %}
        {% endif %}

    {% elseif payLaterData and payLaterData.paymentMethodId is same as(context.paymentMethod.id) %}

        {% block swag_paypal_pay_later %}
        <paypal-pay-later-button
            class="swag-paypal-button shape-{{ payLaterData.buttonShape }} paypal-gold"
            data-swag-paypal-checkout-pay-later="true"
            data-swag-paypal-checkout-pay-later-options="{{ payLaterData|json_encode }}"
            hidden
        >
        </paypal-pay-later-button>
        {% endblock %}

    {% elseif acdcData and acdcData.paymentMethodId is same as(context.paymentMethod.id) %}

        {% block swag_paypal_acdc %}
        <div
            data-swag-paypal-checkout-card-fields="true"
            data-swag-paypal-checkout-card-fields-options="{{ acdcData|json_encode }}"
        >
        </div>
        {% endblock %}

    {% elseif puiFraudnetData and puiFraudnetData.paymentMethodId is same as(context.paymentMethod.id) %}

        {% block swag_paypal_pui %}
        <script type="application/json" fncls="fnparams-dede7cc5-15fd-4c75-a9f4-36c430ee3a99">
            {
                "f": "{{ puiFraudnetData.sessionIdentifier }}",
                "s": "{{ puiFraudnetData.websiteIdentifier }}",
                "sandbox": {{ puiFraudnetData.sandbox ? "true" : "false" }}
            }
        </script>
        <script type="text/javascript" src="https://c.paypal.com/da/r/fb.js"></script>

        <input type="hidden" name="{{ constant('Swag\\PayPal\\Checkout\\Payment\\Method\\PUIHandler::PUI_FRAUD_NET_SESSION_ID') }}" value="{{ puiFraudnetData.sessionIdentifier }}">
        {% endblock %}

    {% elseif sepaData and sepaData.paymentMethodId is same as(context.paymentMethod.id) %}

        {# @TODO - Replace with v6 equivalent #}
        {% block swag_paypal_sepa %}
        <div
            data-swag-paypal-sepa="true"
            data-swag-paypal-sepa-options="{{ sepaData|json_encode }}"
        >
        </div>
        {% endblock %}

    {% elseif venmoData and venmoData.paymentMethodId is same as(context.paymentMethod.id) %}

        {% block swag_paypal_venmo %}
        <venmo-button
            class="swag-paypal-button shape-{{ venmoData.buttonShape }} paypal-blue"
            data-swag-paypal-checkout-venmo="true"
            data-swag-paypal-checkout-venmo-options="{{ venmoData|json_encode }}"
            hidden
        >
        </venmo-button>
        {% endblock %}


    {% elseif applePayData and applePayData.paymentMethodId is same as(context.paymentMethod.id) %}

        {% block swag_paypal_apple_pay %}
        <apple-pay-button
            class="swag-paypal-button shape-{{ applePayData.buttonShape }} d-none"
            buttonstyle="black"
            data-swag-paypal-checkout-apple-pay="true"
            data-swag-paypal-checkout-apple-pay-options="{{ applePayData|json_encode }}"
            disabled
        >
        </apple-pay-button>
        {% endblock %}

    {% elseif googlePayData and googlePayData.paymentMethodId is same as(context.paymentMethod.id) %}

        {% block swag_paypal_google_pay %}
        <google-pay-button
            class="swag-paypal-button shape-{{ googlePayData.buttonShape }}"
            button-size-mode="fill"
            data-swag-paypal-checkout-google-pay="true"
            data-swag-paypal-checkout-google-pay-options="{{ googlePayData|json_encode }}"
            data-total-price-label="{{ 'checkout.summaryTotalPrice'|trans|sw_sanitize|striptags }}"
        >
        </google-pay-button>
        {% endblock %}
    {% endif %}
</div>
{% endblock %}
