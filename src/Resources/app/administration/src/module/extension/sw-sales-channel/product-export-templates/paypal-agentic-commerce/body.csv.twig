{% set preOrder = product.releaseDate and product.releaseDate|date('U') > 'now'|date('U') %}
{% set price = product.calculatedPrice %}
{%- if product.calculatedPrices.count > 0 -%}
    {% set price = product.calculatedPrices.last %}
{%- endif -%}
{% set countryIso = productExport.storefrontSalesChannel.country.iso3 %}
{% set priceValue = price.unitPrice %}
{%- if countryIso === 'USA' or countryIso === 'CAN' -%}
    {% set priceValue = priceValue - price.calculatedTaxes.first.tax %}
{%- endif -%}
"{{ product.productNumber }}",
"{{ product.parentId }}",
"{{ product.translated.name }}",
"{{ seoUrl('frontend.detail.page', {'productId': product.id}) }}",
"{{ product.manufacturerNumber }}",
"{{ product.manufacturer.translated.name }}",
"{{ product.ean }}",
"{{ priceValue|currency }}",
"{{ priceValue|currency }}",
"{%- if preOrder -%}preorder{%- elseif product.availableStock >= product.minPurchase -%}in_stock{% else %}out_of_stock{% endif %}",
"{%- if preOrder -%}{{ product.releaseDate|date('Y-m-d\\Th:m', product.releaseDate.timezone) }}{% endif %}",
"{%- if product.categories.count > 0 -%}
    {{ product.categories.first.getBreadCrumb|slice(1)|join(' > ')|raw }}
{%- endif -%}",
"{%- if product.categories.count > 0 -%}
    {{ product.categories.first.getBreadCrumb|slice(1)|join(' > ')|raw }}
{%- endif -%}",
"{% if product.cover is not null %}{{ product.cover.media.url }}{% endif %}",
"{% if product.media.first is not null %}{{ product.media.first.media.url }}{% endif %}",
"{{ product.translated.description|striptags|raw|length > 300 ? product.translated.description|striptags|raw|slice(0,300) ~ '...' : product.translated.description|striptags|raw }}"
