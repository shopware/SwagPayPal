<mt-card
    class="swag-paypal-settings-environment"
    position-identifier="swag-paypal-settings-environment"
    :title="$t('swag-paypal-settings.environment.title')"
    :is-loading="settingsStore.isLoading"
>
    <div class="swag-paypal-settings-environment__content">
        <span class="swag-paypal-settings-environment__info-text">
            {{ $t('swag-paypal-settings.environment.info') }}
        </span>

        <swag-paypal-setting path="SwagPayPal.settings.isLocalEnvironment" />
    </div>
</mt-card>

{% block swag_paypal_settings_webhook %}
<swag-paypal-settings-webhook />
{% endblock %}

<mt-card
    class="swag-paypal-settings-cross-border"
    position-identifier="swag-paypal-settings-cross-border"
    :title="$t('swag-paypal-settings.crossBorder.title')"
    :is-loading="settingsStore.isLoading"
>
    <div class="swag-paypal-settings-cross-border__content">
        <mt-banner class="swag-paypal-settings-cross-border__warning-text" variant="attention">
            {{ $t('swag-paypal-settings.crossBorder.warning') }}
        </mt-banner>

        <span class="swag-paypal-settings-cross-border__info-text">
            {{ $t('swag-paypal-settings.crossBorder.info') }}
        </span>

        <swag-paypal-setting path="SwagPayPal.settings.crossBorderMessagingEnabled" />

        <swag-paypal-setting
            path="SwagPayPal.settings.crossBorderBuyerCountry"
            :options="countryOverrideOptions"
        />
    </div>
</mt-card>

{% block swag_paypal_settings_logs %}
<mt-card
    class="swag-paypal-settings-logs"
    position-identifier="swag-paypal-settings-logs"
    :title="$t('swag-paypal-settings.logs.title')"
    :is-loading="settingsStore.isLoading"
>
    <div class="swag-paypal-settings-logs__content">
        <i18n-t
            class="swag-paypal-settings-logs__info-text"
            keypath="swag-paypal-settings.logs.info"
            tag="span"
        >
            <template #diagnostics>
                <mt-link
                    type="internal"
                    :to="{ name: 'swag.paypal.settings.index.diagnostics' }"
                >
                    {{ $t('swag-paypal-settings.tabs.diagnostics') }}
                </mt-link>
            </template>
        </i18n-t>

        <swag-paypal-setting
            path="SwagPayPal.settings.logLevel"
            :options="logLevelOptions"
            :disabled="!!settingsStore.salesChannel"
        />
    </div>
</mt-card>
{% endblock %}
