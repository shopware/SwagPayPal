export default "{% block sw_sales_channel_detail_base_general_input_product_comparison_template %}\n    <template v-if=\"!isAgenticCommerceType\">\n        {% parent %}\n    </template>\n{% endblock %}\n\n{% block sw_sales_channel_detail_base_general_input_product_comparison_filename %}\n    <template v-if=\"!isAgenticCommerceType\">\n        {% parent %}\n    </template>\n{% endblock %}\n\n{% block sw_sales_channel_detail_base_general_input_product_comparison_encoding %}\n    <template v-if=\"!isAgenticCommerceType\">\n        {% parent %}\n    </template>\n{% endblock %}\n\n{% block sw_sales_channel_detail_base_general_input_product_comparison_file_format %}\n    <template v-if=\"!isAgenticCommerceType\">\n        {% parent %}\n    </template>\n{% endblock %}\n\n{% block sw_sales_channel_detail_base_options_status_description %}\n    <template v-if=\"isAgenticCommerceType\">\n        <div class=\"sw-sales-channel-detail-base__description-text\">\n            {{ $t('swag-paypal-agentic-commerce.sales-channel.detail.textActiveDescription') }}\n        </div>\n    </template>\n{% endblock %}\n\n{% block sw_sales_channel_detail_base_options_api %}\n    <template v-if=\"!isAgenticCommerceType\">\n        {% parent %}\n    </template>\n{% endblock %}\n\n{% block sw_sales_channel_detail_base_options_maintenance_header %}\n    <template v-if=\"!isAgenticCommerceType\">\n        {% parent %}\n    </template>\n{% endblock %}\n\n{% block sw_sales_channel_detail_base_maintenance_input_active %}\n    <template v-if=\"!isAgenticCommerceType\">\n        {% parent %}\n    </template>\n{% endblock %}\n\n{% block sw_sales_channel_detail_base_maintenance_ipwhitelist %}\n    <template v-if=\"!isAgenticCommerceType\">\n        {% parent %}\n    </template>\n{% endblock %}\n\n{% block sw_sales_channel_detail_base_settings_link %}\n    <template v-if=\"!isAgenticCommerceType\">\n        {% parent %}\n    </template>\n{% endblock %}\n\n{% block sw_sales_channel_detail_base_options_delete %}\n    <sw-card\n        v-if=\"isAgenticCommerceType\"\n        class=\"swag-paypal-settings-webhook\"\n        position-identifier=\"swag-paypal-settings-webhook\"\n    >\n        <template #title>\n            <div class=\"sw-card__title swag-paypal-settings-webhook__title\">\n                <p>\n                    {{ $t('swag-paypal-settings.webhook.title') }}\n                </p>\n\n                <sw-label\n                    class=\"swag-paypal-settings-webhook__label\"\n                    appearance=\"pill\"\n                    size=\"medium\"\n                    :variant=\"webhookStatusVariant\"\n                >\n                    <sw-color-badge :rounded=\"true\" :variant=\"webhookStatusVariant\" />\n                    <span>{{ webhookStatusLabel }}</span>\n                </sw-label>\n            </div>\n        </template>\n\n        <div class=\"swag-paypal-settings-webhook__content\">\n        <span class=\"swag-paypal-settings-webhook__info-text\">\n            {{ $t('swag-paypal-settings.webhook.honey.info') }}\n        </span>\n\n            <sw-button\n                class=\"swag-paypal-settings-webhook__refresh-button\"\n                variant=\"secondary\"\n                :disabled=\"!salesChannel.active\"\n                :is-loading=\"isRefreshingWebhook\"\n                @click=\"onRefreshWebhook\"\n            >\n                {{ $t('swag-paypal-settings.webhook.buttonRefresh') }}\n            </sw-button>\n        </div>\n    </sw-card>\n\n    {% parent %}\n{% endblock %}\n";